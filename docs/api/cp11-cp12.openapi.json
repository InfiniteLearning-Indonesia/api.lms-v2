{
  "openapi": "3.1.0",
  "info": {
    "title": "LMS v3 CP11-CP12 local lifecycle contract",
    "version": "0.1.0",
    "description": "Local synthetic HTTPS lab only. Real legacy issuer/provisioning adapter, browser integration and deployment remain unverified. Cookie-only gateway rejects Authorization headers and URL query strings. JWT EdDSA pinned kid; issuer/audience/purpose/iat/nbf/exp/JTI/version; max assertion age 60s, no leeway. Account freshness <= assertion expiry; session rotation window 15min, absolute lifetime 1h. __Host cookies Secure/HttpOnly/SameSite=Strict/Path=/, no Domain. Session and authority mutations serialize with domain transactions through a DB fence; no instantaneous external-issuer revocation claim. Invite/reset/profile/setup-password routes return 404 OWNER_ROUTE_NOT_AVAILABLE. JSON bodies limited to 12KiB auth/16KiB Class. Frozen scope and residual gates: docs/checkpoints/CP11-CP12_ACCEPTANCE.md."
  },
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/v3/auth/challenge": {
      "post": {
        "summary": "Create single-use browser-bound challenge (60 seconds).",
        "operationId": "post__v3_auth_challenge",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured HTTPS origin; no trust in forwarded origin."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON/input"
          },
          "401": {
            "description": "Invalid/expired session or assertion"
          },
          "403": {
            "description": "Capability, CSRF or origin denied"
          },
          "404": {
            "description": "Resource or owner-only route unavailable"
          },
          "409": {
            "description": "State/version/replay/invariant conflict"
          },
          "429": {
            "description": "Process-local challenge limit reached (120/minute)."
          },
          "503": {
            "description": "Dependency unavailable; fail closed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Empty"
              }
            }
          }
        },
        "security": []
      }
    },
