        "summary": "Site admin reopen with state/version guard. CLOSED is read-only; ARCHIVED terminal.",
        "operationId": "post__v3_classes_class_id_reopen",
        "parameters": [
          {
            "name": "class_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured HTTPS origin; no trust in forwarded origin."
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "description": "Actor-scoped. Same key/payload replays only after current authorization; different payload conflicts."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Class"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON/input"
          },
          "401": {
            "description": "Invalid/expired session or assertion"
          },
          "403": {
            "description": "Capability, CSRF or origin denied"
          },
          "404": {
            "description": "Resource or owner-only route unavailable"
          },
          "409": {
            "description": "State/version/replay/invariant conflict"
          },
          "503": {
            "description": "Dependency unavailable; fail closed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Version"
              }
            }
          }
        }
      }
    },
