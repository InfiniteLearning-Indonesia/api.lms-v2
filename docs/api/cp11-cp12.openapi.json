  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-lms-v3"
      },
      "ChallengeCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-lms-v3-challenge"
      }
    },
    "schemas": {
      "Empty": {
        "type": "object",
        "additionalProperties": false
      },
      "Assertion": {
        "type": "object",
        "required": [
          "assertion"
        ],
        "additionalProperties": false,
        "properties": {
          "assertion": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "SiteRole": {
        "type": "object",
        "required": [
          "user_id",
          "admin",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "admin": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CreateClass": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Non-blank; Go additionally enforces at most 200 UTF-8 bytes."
          },
          "program_label": {
            "type": "string",
            "maxLength": 200,
            "description": "At most 200 UTF-8 bytes."
          },
          "cohort_label": {
            "type": "string",
            "maxLength": 200,
            "description": "At most 200 UTF-8 bytes."
          }
        }
      },
      "EditClass": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Non-blank; Go additionally enforces at most 200 UTF-8 bytes."
          },
          "program_label": {
            "type": "string",
            "maxLength": 200,
            "description": "At most 200 UTF-8 bytes."
          },
          "cohort_label": {
            "type": "string",
            "maxLength": 200,
            "description": "At most 200 UTF-8 bytes."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Participant": {
        "type": "object",
        "required": [
          "user_id",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher",
              "student"
            ]
          }
        }
      },
      "Class": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "program_label": {
            "type": "string"
          },
          "cohort_label": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "CLOSED",
              "ARCHIVED"
            ]
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "Credential": {
        "type": "object",
        "required": [
          "csrf_token"
        ],
        "properties": {
          "csrf_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Actor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "site_admin": {
            "type": "boolean"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "nonce": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Participation": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "string"
          },
          "enrollment_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "ENDED"
            ]
          }
        }
      }
    }
  }
}
