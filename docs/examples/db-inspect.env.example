# Reference only. Does not replace your existing .env.staging or .env.example.
# Never add production/session/SMTP/R2 credentials to this tracked example.
DB_HOST=database-host-from-provider.invalid
DB_PORT=5432
DB_USER=read_only_operator
DB_NAME=database_name_from_provider
DB_PASSWORD=REPLACE_LOCALLY_DO_NOT_COMMIT
DB_SSL=true
# Optional when system trust already validates the server; otherwise supply the
# CA downloaded from this project's provider dashboard. Relative to env file.
DB_SSL_ROOT_CERT=certs/staging-provider-ca.crt
